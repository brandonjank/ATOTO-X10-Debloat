<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:gravity="center_vertical"
 android:padding="10dp" android:background="@drawable/widget_background">
 <TextView android:id="@+id/open" android:layout_width="match_parent" android:layout_height="wrap_content"
  android:text="Audible" android:textColor="#FFFFA72B" android:textSize="16sp" android:textStyle="bold"
  android:paddingBottom="6dp" android:contentDescription="Open Audible"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal">
  <TextView android:id="@+id/back" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
   android:text="Back" android:textColor="#FFFFFFFF" android:textSize="14sp" android:gravity="center" android:background="@drawable/button_background" android:contentDescription="Audible rewind"/>
  <TextView android:id="@+id/toggle" android:layout_width="0dp" android:layout_weight="1.35" android:layout_height="match_parent"
   android:layout_marginLeft="6dp" android:layout_marginRight="6dp" android:text="Play / pause" android:textColor="#FFFFFFFF" android:textSize="14sp" android:gravity="center" android:background="@drawable/button_background" android:contentDescription="Audible play or pause"/>
  <TextView android:id="@+id/forward" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
   android:text="Forward" android:textColor="#FFFFFFFF" android:textSize="14sp" android:gravity="center" android:background="@drawable/button_background" android:contentDescription="Audible fast forward"/>
 </LinearLayout>
</LinearLayout>
