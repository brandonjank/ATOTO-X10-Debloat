<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="io.atoto.x10home" android:versionCode="2" android:versionName="0.1.1-preview">
  <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="33"/>
  <queries>
    <intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent>
    <intent><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent>
    <package android:name="com.zhonghong.appwidgets"/>
    <package android:name="com.zhonghong.weatherwidget"/>
    <package android:name="com.google.android.apps.maps"/>
    <package android:name="com.pandora.android"/>
